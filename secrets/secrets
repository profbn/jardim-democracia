import base64
import hashlib
import secrets
import string


def gerar_credenciais_128bits(comprimento_senha=24, iteracoes_sha=4096):
    # 1. Geração de 128 bits de entropia pura (16 bytes)
    entropia_bytes = secrets.token_bytes(16)

    # 2. Representações diretas dos 128 bits
    hex_128bit = entropia_bytes.hex()
    base64_128bit = base64.b64encode(entropia_bytes).decode("utf-8")

    # 3. Senha legível gerada com 128 bits de amostragem segura
    alfabeto = (
        string.ascii_letters + string.digits + "!@#$%^&*()_+-=[]{}|;:,.<>?"
    )
    senha_texto = "".join(
        secrets.choice(alfabeto) for _ in range(comprimento_senha)
    )

    # 4. Hash SHA-512 direto dos 128 bits
    sha512_direct = hashlib.sha512(entropia_bytes).hexdigest()

    # 5. Key Derivation Function: PBKDF2 usando SHA-512 com 4096 iterações
    salt = secrets.token_bytes(16)
    kdf_sha4096_iter = hashlib.pbkdf2_hmac(
        hash_name="sha512",
        password=entropia_bytes,
        salt=salt,
        iterations=iteracoes_sha,
        dklen=64,  # Saída de 512 bits (64 bytes)
    )

    return {
        "hex_128bit": hex_128bit,
        "base64_128bit": base64_128bit,
        "senha_texto": senha_texto,
        "sha512_digest": sha512_direct,
        "salt_hex": salt.hex(),
        "pbkdf2_sha512_4096_hex": kdf_sha4096_iter.hex(),
    }


if __name__ == "__main__":
    credenciais = gerar_credenciais_128bits()

    print("--- GERADOR DE SENHAS E CHAVES CRIPTOGRÁFICAS ---")
    print(f"• Chave Hexadecimal (128 bits):   {credenciais['hex_128bit']}")
    print(f"• Chave Base64 (128 bits):        {credenciais['base64_128bit']}")
    print(f"• Senha Forte Sugerida:           {credenciais['senha_texto']}")
    print("\n--- PROCESSAMENTO DE HASH E KDF ---")
    print(f"• Hash SHA-512 (Direto):          {credenciais['sha512_digest']}")
    print(f"• Salt Utilizado (Hex):           {credenciais['salt_hex']}")
    print(
        f"• PBKDF2-HMAC-SHA512 (4096 Iter): {credenciais['pbkdf2_sha512_4096_hex']}"
    )